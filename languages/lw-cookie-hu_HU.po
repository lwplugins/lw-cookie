msgstr "Sütisorok listájának kell lennie."

#. translators: %s: comma-separated list of allowed values
#: includes/SiteManager/CookieService.php:113
#, php-format
msgid "Must be one of: %s."
msgstr "Ezek egyike lehet: %s."

#: includes/SiteManager/CookieService.php:115
msgid "Must be a hex colour such as #2271b1."
msgstr "Hexa színkódnak kell lennie, például #2271b1."

#: includes/SiteManager/CookieService.php:117
msgid "Must be a text value."
msgstr "Szöveges értéknek kell lennie."

